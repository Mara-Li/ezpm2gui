{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./bin",
    "rootDir": "./bin",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "allowJs": true
  },
  "include": ["bin/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
