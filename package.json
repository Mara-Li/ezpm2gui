{
  "name": "@mara-li/ezpm2gui",
  "version": "1.12.6",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.0",
  "bin": {
    "ezpm2gui": "bin/ezpm2gui.js",
    "ezpm2gui-generate-ecosystem": "bin/generate-ecosystem.js"
  },
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "concurrently --kill-others-on-fail --names \"server,client\" --prefix-colors \"cyan,green\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "nodemon --exec ts-node src/server/index.ts",
    "dev:client": "pnpm --filter ezpm2gui-client run dev",
    "build": "pnpm run build:server && pnpm run build:bin",
    "postbuild": "node scripts/postbuild.js",
    "mobile": "node scripts/deploy-mobile.js",
    "mobile:dev": "node scripts/deploy-mobile.js dev",
    "mobile:android": "node scripts/deploy-mobile.js android --debug --install",
    "mobile:android:release": "node scripts/deploy-mobile.js android --release",
    "mobile:debug": "powershell -ExecutionPolicy Bypass -File scripts/Debug-Mobile.ps1",
    "mobile:debug:dump": "powershell -ExecutionPolicy Bypass -File scripts/Debug-Mobile.ps1 -Dump",
    "mobile:ps": "powershell -ExecutionPolicy Bypass -File scripts/Deploy-Mobile.ps1",
    "mobile:ps:release": "powershell -ExecutionPolicy Bypass -File scripts/Deploy-Mobile.ps1 -Mode release -Install -Launch",
    "mobile:ps:debug": "powershell -ExecutionPolicy Bypass -File scripts/Deploy-Mobile.ps1 -Mode debug -Install -Launch",
    "mobile:ios": "node scripts/deploy-mobile.js ios",
    "mobile:ios:release": "node scripts/deploy-mobile.js ios --release",
    "build:server": "tsc",
    "build:client": "pnpm --filter ezpm2gui-client run build",
    "build:bin": "tsc --project tsconfig.bin.json",
    "prepare": "pnpm --include-workspace-root -r run build",
    "test": "ts-node tests/unit/server-selection.test.ts && ts-node tests/unit/theme.test.ts && ts-node tests/unit/app-version.test.ts && ts-node tests/unit/ansi.test.ts"
  },
  "keywords": [
    "pm2",
    "gui",
    "monitor",
    "process-manager",
    "dashboard"
  ],
  "author": "Mara-Li",
  "contributors": [
    "Chandan Bhagat (original author, https://github.com/thechandanbhagat)"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mara-Li/ezpm2gui.git"
  },
  "bugs": {
    "url": "https://github.com/Mara-Li/ezpm2gui/issues"
  },
  "homepage": "https://github.com/Mara-Li/ezpm2gui#readme",
  "description": "A modern web-based GUI for PM2 process manager",
  "files": [
    "dist/",
    "bin/",
    "src/client/build/"
  ],
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "commit-and-tag-version": "^13.0.0",
    "cron-parser": "^5.6.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pm2": "^7.0.3",
    "socket.io": "^4.8.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ssh2": "^1.15.5",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "commit-and-tag-version": {
    "bumpFiles": [
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "t": "v"
  }
}
